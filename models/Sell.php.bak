}
    public function getSumPostponed($model)
    {
        $sum=0;
        $query = Arrival::find()->select('id_product,id_store')
            ->joinWith('idProduct.idType')
            ->where($model->where)
            ->groupBy("id_product")->all();
        $i=0;

        foreach($query as $model) {
//echo  $model->id_product."<br>";
            $sell=Sell::find()->select("sum(postponed) as postponed")->where(["id_product" => $model->id_product,'returnp'=>0])
                ->groupBy("id_product")->one()->postponed;
            //print_r($sell);
            $sum=$sum+$sell;
            $test[$i]=$sell;
            $i++;
            // echo $sell;
        }
        return $sum;
    }

    public function getSumRest($model,$column){
        $sum=0;
        $query = Arrival::find()->select('sum(rest) as rest,sum(price*rest) as sum,sum(usd*rest) as usd,id_product,id_store')
            //->joinWith('idProduct.idType')
            //->where($model->where)
			->one();
      
        return $query->$column;
    }
	public function getSumPriceArRest()
	{
		return $this->quantity * $this->getPriceAr();
		
	}
	
	public function getSumPriceAr($model)
	{
		$sum = 0;
		foreach (Sell::find()->select("sum(quantity) as quantity,id_product")
            ->joinWith('idProduct.idType')//->joinWith(['idProduct.barcodes'])
            ->andWhere($model->where)->groupBy("sell.id_product")->all() as $query )
			{
				
				
				$sum = $sum +  $query->quantity *  Arrival::find()
            ->where(['id_product'=> $query->id_product])->orderBy("id DESC")->one()->price;
				
			}
		return round($sum,2);
	}
	
	public function getGetKassa()
	{
		$kassa = Kassa::find()->where(["id" => Costs::find()->where(["id_type" => 3, "fid"=> $this->number])->one()->id_kassa])->one();
		if ($kassa->name) return $kassa->name;
		return "-";
	}
	
	public function getBoxing()
	{
		$boxing=Product::find()->where(["id"=>$this->id_product])->one()->boxing;
		
		return $boxing;
		
	}
