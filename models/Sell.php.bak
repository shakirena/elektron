    public function getPostponedValue()
    {
        return $this->quantity1-$this->postponed1;
    }

    public function getUsdSum()
    {
        return $this->quantity* $this->usd;
    }

    public function getGetPostponed()
    {

        $sell=Sell::find()->select("sum(postponed) as postponed")->andWhere(['returnp'=>0])->andWhere(["id_product" => $this->id_product])
            ->groupBy("id_product")->one();
        return $sell->postponed;
    }
    public function getSumPostponed1($model)
    {
        $query = Sell::find()->select("sum(quantity) as quantity1,sum(postponed) as postponed1")
            ->joinWith('idProduct.idType')->joinWith('idClient')->joinWith(['idProduct.barcodes'])
            ->andWhere(['returnp'=>0])
            ->andWhere($model->where)->one();
        $sum=$query->quantity1-$query->postponed1;

        return $sum;
    }
    public function getSumCount()
    {
