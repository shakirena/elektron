    public function getGetNumber()
    {


        return $this->number."   ".Html::button('<i class="glyphicon glyphicon-ok"></i>OK',["onclick"=> "cancel($this->number)"]);
    }
    public function getSearch($number)
    {
        $query = Sell::find()->select("sum(quantity) as quantity1,sum(postponed) as postponed1")
            ->andWhere(['number' => $this->number,'returnp'=>0])->one();
        if ($query->quantity1==$query->postponed1) return 1;
        else return 0;

    }
    public function getStatus($model)
    {
        $query = Sell::find()->select("sum(quantity) as quantity1,sum(postponed) as postponed1")
            ->joinWith('idProduct.idType')->joinWith('idClient')
            ->andWhere($model->query->where)->andWhere(['number' => $this->number,'returnp'=>0])->one();
        $sum=$query->quantity1-$query->postponed1;
        if ($sum==$query->quantity1)
        {   if (Dclient::find()->where(['number'=> $this->number])->one()->debt>0)  $color='red';
        else $color='green';}
        else  if ($sum>0) $color='yellow';

        return "<span class='badge' style='background-color: $color'>&nbsp&nbsp $sum</span>";
        // return $sum;
        // if  ($this->getGetPostponed()==)
        // return "drf" ;
    }
    public function getSumArrival($model,$column){
        $sum=0;
		$model2=$model->where;
		
		foreach ($model2 as $key=>$where)
		{
			if ($where[1]=="`bar_code`.`name`") 
					{ 
			
						foreach (Barcodep::find()->andWhere(['like', 'name',"%$where[2]%", false])->all() as $barcode){

						$product[]=$barcode->id_product;
						
						}
						unset($model2[$key]);
						
					}
		}
        $query =  Sell::find()->select("sum(quantity) as quantity,sum(sum) as sum,sum(earnings) as earnings,sum(quantity*usd) as usd")
            ->joinWith('idProduct.idType')
            ->joinWith('idClient')
            ->andWhere(['returnp'=>0])->andWhere($model2
			)->andFilterWhere(["in","id_product",$product])->one();

if ($column=='earnings')  
	if (  Yii::$app->user->identity->id_role!=6 ) return '-';
	
        return round($query->$column,2);
    }
	
	public function getPriceSell()
    {
        $arrival=Arrival::find()
            ->select('pricesell')
            ->where(['id_product' => $this->id_product])
            ->orderBy([
                'id' => SORT_DESC
            ])
            ->one();
       return $arrival->pricesell;
    }
    public function getSumBalance($model){
        $sum=0;
        foreach(Sell::find()->joinWith('idProduct.idType') ->joinWith('idClient')->joinWith(['idProduct.barcodes'])
                    ->andWhere(['returnp'=>0])->andWhere($model->where)->groupBy("number")->all() as $sell){
            $query =  Balance::find()->select("sum(sum) as sum")
                ->where(["number" => $sell->number])->andWhere(" balance.id_type=2 or balance.id_type=3")->one();

            $sum=$sum+ $query->sum;
        }


        return $sum;
    }

    public function getSumBorc($model){
        $sum=0;
       foreach(Sell::find()->joinWith('idProduct.idType') ->joinWith('idClient')->joinWith(['idProduct.barcodes'])
                    ->andWhere(['returnp'=>0])->andWhere($model->where)->groupBy("number")->all() as $sell){
            $query =  Dclient::find()->where(["number" => $sell->number])->one();
            if ($query->debt)
            $sum=$sum+ $query->debt;
        }

        return $sum;
    }
	 public function getRestBorc(){
     
            $query =  Dclient::find()->where(["number" => $this->number])->one();
           
        

        return  $query->debt;
    }
    public function getBehBalance($model){
        $sum=0;
        foreach(Sell::find()->joinWith('idProduct.idType') ->joinWith('idClient')->joinWith(['idProduct.barcodes'])
                    ->andWhere(['returnp'=>0]) ->andWhere($model->where)->groupBy("number")->all() as $sell){
            $query =  Balance::find()->select("sum(sum) as sum")
                ->where(["number" => $sell->number])->andWhere("balance.id_type=1")->one();

            $sum=$sum+ $query->sum;
        }


        return $sum;
    }
