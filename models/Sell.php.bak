    public function getIdType()
    {
        return $this->getIdProduct()->one()->id_type;

    }
    public function getGetType()
    {
        $parent=TypeProduct::find()->where(["id" =>  $this->getIdType()])->one();
        if ($parent) $name2=$parent->name;

        $parent=TypeProduct::find()->where(["id" =>  $parent->id_parent])->one();
        if ($parent) $name1=$parent->name."/";
        $parent=TypeProduct::find()->where(["id" =>  $parent->id_parent])->one();
        if ($parent) $name1=$parent->name."/";

        $parent=TypeProduct::find()->where(["id" =>  $parent->id_parent])->one();
        if ($parent) $name1=$parent->name."/";

        $parent=TypeProduct::find()->where(["id" =>  $parent->id_parent])->one();
        if ($parent) $name1=$parent->name."/";


        $name=$name1.$name2;

        $product="(";
        foreach(Sell::find()->where(['number'=>$this->number, 'returnp'=>0])
                    ->all() as $sell)
        {
            if ($sell->postponed>0) $color='#E5C609'; else $color="";
            if ($sell->quantity>1)
                $product.="<span style='color:$color'>".$sell->getIdProduct()->one()->name. " ($sell->quantity əd) </span>".",";
            else  $product.="<span style='color:$color'>".$sell->getIdProduct()->one()->name."</span>,";
        }
        $product=rtrim($product,',');
        $product.=")";
        $name.=$product;
        return $name;
    }

    public function getGetType1()
    {
        $parent=TypeProduct::find()->where(["id" =>  $this->getIdType()])->one();
        if ($parent) $name2=$parent->name;

        $parent=TypeProduct::find()->where(["id" =>  $parent->id_parent])->one();
        if ($parent) $name1=$parent->name."/";
        $parent=TypeProduct::find()->where(["id" =>  $parent->id_parent])->one();
        if ($parent) $name1=$parent->name."/";

        $parent=TypeProduct::find()->where(["id" =>  $parent->id_parent])->one();
        if ($parent) $name1=$parent->name."/";

        $parent=TypeProduct::find()->where(["id" =>  $parent->id_parent])->one();
        if ($parent) $name1=$parent->name."/";


        $name=$name1.$name2;

        $product="(";
        foreach(Sell::find()->where(['number'=>$this->number,'returnp'=>0])
                    ->all() as $sell)
        {

            if ($sell->quantity>1)
                $product.=$sell->getIdProduct()->one()->name. " ($sell->quantity əd)".",";
            else  $product.=$sell->getIdProduct()->one()->name.",";
        }
        $product=rtrim($product,',');
        $product.=")";
        $name.=$product;
        return $name;
    }
   
    public function getTest()
    {
        $balance=Balance::find()->select("sum(sum) as sum")->where(["number"=>$this->number])->andWhere("balance.id_type=1")->one()->sum;
        // $balance=Dclient::find()->where(["number"=>$this->number])->one()->debt;
        return $balance;
    }
    public function getTest1()
    {
        $balance=Balance::find()->select("sum(sum) as sum")->where(["number"=>$this->number])->andWhere("balance.id_type=2 or balance.id_type=3")->one()->sum;
        // $balance=Dclient::find()->where(["number"=>$this->number])->one()->debt;
        return $balance;
    }
    public function getTest2()
    {
        $balance=Dclient::find()->where(["number"=>$this->number])->one()->debt;
        // $balance=Dclient::find()->where(["number"=>$this->number])->one()->debt;
