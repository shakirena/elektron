    /**
     * @inheritdoc
     */
    public function rules()
    {
        return [
            [['id_user', 'id_product',  'datetime'], 'required'],
            [['id_user','user_issue', 'id_product', 'sold', 'id_client', 'number', 'flag','id_store'], 'integer'],
            [['quantity', 'price','usd', 'price_ar', 'discount', 'sum', 'earnings', 'returnp', 'debt'], 'number'],
            [['datetime','date_issue','postponed'], 'safe'],
            [['sn'], 'string', 'max' => 100],
            [['id_client'], 'exist', 'skipOnError' => true, 'targetClass' => Client::className(), 'targetAttribute' => ['id_client' => 'id_client']],
            [['id_user'], 'exist', 'skipOnError' => true, 'targetClass' => Users::className(), 'targetAttribute' => ['id_user' => 'id_user']],
            [['user_issue'], 'exist', 'skipOnError' => true, 'targetClass' => Users::className(), 'targetAttribute' => ['user_issue' => 'id_user']],
            [['id_product'], 'exist', 'skipOnError' => true, 'targetClass' => Product::className(), 'targetAttribute' => ['id_product' => 'id']],
          //  [['id_master'], 'exist', 'skipOnError' => true, 'targetClass' => Master::className(), 'targetAttribute' => ['id_master' => 'id']],


        ];
    }

