    public function actionAbout()
    {


        $searchModel = new Sell2Search(['sold'=>0,'id_user'=> Yii::$app->user->identity->id_user,'returnp' =>0]);
        $dataProvider = $searchModel->search(Yii::$app->request->queryParams);
        // var_dump($searchModel) ;
        $sum=Sell2::find()->select('sum(sum) as sum')->where(['sold'=>'0','id_user'=> Yii::$app->user->identity->id_user])->groupBy('number')->one()->sum;
        $usd=Sell2::find()->select('sum(usd*quantity) as sum')->where(['sold'=>'0','id_user'=> Yii::$app->user->identity->id_user])->groupBy('number')->one()->sum;


        return $this->render('index', [
            'searchModel' => $searchModel,
            'dataProvider' => $dataProvider,
            'sum'=> $sum,
            'usd'=> $usd

        ]);
    }

