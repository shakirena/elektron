    public function actionPostponedShow($number)
    {
        $model=Sell::find()->select("sell.id,name as name_product,sell.postponed as quantity, id_product,product.id_type as id_client")->joinWith("idProduct")->where(["number" => $number])->andWhere("postponed>0 and returnp=0")->all();
        return $this->renderAjax('postponed_show', [
            'model' => $model,


        ]);
    }
    public function actionReturnShow($number)
    {
        $model=Sell::find()->select("sell.id,name as name_product,(sell.quantity-sell.postponed) as quantity")->joinWith("idProduct")->where(["number" => $number])->andWhere("postponed<quantity and returnp=0")->all();
        return $this->renderAjax('return_show', [
            'model' => $model,


        ]);
    }
	
	public function actionReturnSellReceived($sum,$store,$user,$bonusum)
    {
	
		
			  $max = Returnp::find()->select('number')->max('number');
						if ($max) $max = $max + 1;
						else $max = 1;
				$summa = 0;
					if (Yii::$app->session->get('id_client') == 300) 
							{
									$arrival=Arrival::find()->where(['id_product' => $return->id_product])->orderBy(['datetime' => SORT_DESC])->one();
									$max2 = Arrival2::find()->select('number')->max('number');
											if ($max2) $max2 = $max2 + 1;
											else $max2 = 1;
							}
				  foreach (Sell2::find()->where(['sold' => 0,'postponed'=>0,'id_user'=>Yii::$app->user->identity->id_user])->all() as $sell) {
						
						$return=new Returnp();
						$return->id_product=$sell->id_product;
						$return->id_user=$user;
						$return->id_client=Yii::$app->session->get('id_client');;
						$return->id_store=$store;
						$return->data=date("Y-m-d");
						$return->received=0;
						$return->quantity=$sell->quantity;
						$return->number=$max;
						$return->price=$sell->price;
			   
						$return->save();
						$summa = $summa + $sell->sum;
						$arrival=Arrival::find()->where(['id_product' => $sell->id_product, 'id_store' => $store])->orderBy(['datetime' => SORT_DESC])->one();
						if ($arrival->id)
						{
							$arrival->rest=$arrival->rest+$return->quantity;
							$arrival->save();
						}
						else 
						{
							$arrival=Arrival::find()->where(['id_product' => $sell->id_product])->orderBy(['datetime' => SORT_DESC])->one();
							if ($arrival->id)
							{
								$price=$arrival->price;
								
							}
								else $price=$sell->price;
							
								$max1 = Arrival::find()->select('number')->max('number');
											if ($max1) $max1 = $max1 + 1;
											else $max1 = 1;
								$arrival=new Arrival();
										
								$arrival->id_product =$sell->id_product;
								$arrival->quantity = $sell->quantity;
								$arrival->rest = $sell->quantity;
								$arrival->price =$price;
											
								$arrival->pricesell =$sell->price;
								$arrival->pack =1;
								$arrival->id_store= $store;
								$arrival->number= $max1;
								$arrival->datetime=date("Y-m-d H:i:s");
								$arrival->sum = $price*$row->quantity;
								$arrival->id_user = Yii::$app->user->identity->id_user;
								$arrival->received = 1;
								$arrival->save();
						}
						  
						  
							if (Yii::$app->session->get('id_client') == 300) 
							{
									
									$model=new Arrival2();
										
									$model->id_product =$arrival->id_product;
									$model->quantity = $sell->quantity;
									$model->rest = $sell->quantity;
									$model->price =$sell->price;			
									$model->pricesell =$arrival->pricesell;
									$model->price_top =$arrival->price_top;		
									$model->trade_price =$arrival->trade_price;	
									$model->pricesell_min =$arrival->pricesell_min;										
									$model->pack =1;
									$model->id_store= 1;
									$model->number= $max2;
									$model->datetime=date("Y-m-d H:i:s");
									$model->sum = $sell->price*$sell->quantity;
									$model->id_user = 2;
									$model->received = 0;
									$model->postponed = 1;
									$model->save();
			
						
							}  
						 $sell->delete(); 
						  
				  }
				  
						$bonus =  Bonus::find()->where(['status' =>1])->one();
							if ($bonus->par1) 
								{
									$bonus_sum = $summa*$bonus->par1/100;
								}
							else {
									$bonus_sum = (int)($summa/$bonus->par2)*$bonus->par3;  
							}
							$bonus_sum = -$bonus_sum;
							
						$dclient=new Dclient();
						$dclient->sum=-$sum;
						$dclient->debt=-($summa-$sum-$bonusum);
						$dclient->pos=$bonusum;
						$dclient->number=$max;
						$dclient->id_client=$return->id_client;
						$dclient->datetime=date("Y-m-d H:i:s");
						if (Yii::$app->session->get('id_bonus')==$return->id_client)
						{
						$dclient->bonus=$bonus_sum;
						
						}
						$dclient->save();
						if (Yii::$app->session->get('id_bonus')!=$return->id_client)
						{
							
							
							 
							 $dclient=new Dclient();
							$dclient->sum = 0;
							$dclient->debt = 0;
							$dclient->number=$max;
							$dclient->id_client=Yii::$app->session->get('id_bonus');;
							$dclient->datetime=date("Y-m-d H:i:s");
							$dclient->bonus=$bonus_sum;
							$dclient->pos=$bonusum;
							$dclient->save();
						}
						if (Yii::$app->session->get('id_bonus')) {
							$cost = new Costs();
							$cost->id_kassa = 1;
							$cost->sum = $bonus_sum;
							$cost->fid = $max;
							$cost->id_type = 4;
							$cost->id_client = Yii::$app->session->get('id_bonus');
							$cost->id_user = Yii::$app->user->identity->id_user;
							$cost->datetime=date("Y-m-d H:i:s");
							$cost->save();
							
							$cost = new Costs();
							$cost->id_kassa = 1;
							$cost->sum = -$bonusum;
							$cost->fid = $max;
							$cost->id_type = 3;
							$cost->id_client = Yii::$app->session->get('id_bonus');
							$cost->id_user = Yii::$app->user->identity->id_user;
							$cost->datetime=date("Y-m-d H:i:s");
							$cost->save();
						
						}
					Yii::$app->session->set('id_client', 1);
					Yii::$app->session->set('client', "Müştəri");
		Yii::$app->session->remove('id_bonus');
         Yii::$app->session->remove('bonus');
		
	}
