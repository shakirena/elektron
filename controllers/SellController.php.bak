    public function actionReport()
    {

		$searchModel = new SellSearch(['sold' => '1','postponed'=>0,'returnp'=>0]);

		$searchModel->date_start = date('Y-m-d');//." 00:00:00";
		$searchModel->date_end = date('Y-m-d');//." 23:59:59";
		$dataProvider = $searchModel->search(Yii::$app->request->queryParams);
		
		$return=Returnp::find()->select("sum(price*quantity) as price")->andWhere("data>='$searchModel->date_start' AND data<='$searchModel->date_end'")->one()->price;
		
		if ($_GET[SellSearch][date_start]) $date_start=$_GET[SellSearch][date_start]." 00:00:00"; else 
		  $date_start = date('Y-m-d')." 00:00:00";
		if ($_GET[SellSearch][date_end]) $date_end =  $_GET[SellSearch][date_end]. " 23:59:59"; else 
		  $date_end = date('Y-m-d')." 23:59:59";

		$sum=Sell::find()->select("sum(sum) as sum")->andWhere("datetime>='$date_start' AND datetime<='$date_end' AND sold=1 AND 'postponed'=0 AND 'returnp'=0")->one()->sum;
		  
		
		$earnings = 0;
		foreach (Returnp::find()->andWhere("data>='$searchModel->date_start' AND data<='$searchModel->date_end'")->all() as $returnp)
		{
			$earnings =$earnings+ ($returnp->price - Arrival::find()
            ->where(['id_product'=> $returnp->id_product])->orderBy("id DESC")->one()->price)   * $returnp->quantity;
			
		}
		
		$model = new Sell();
		$sum_earnings = $model->getSumArrival($dataProvider->query,'earnings');
        //$dataProvider=ArrivalSearch::find()->all();

        return $this->render('report', [
            'searchModel' => $searchModel,
            'dataProvider' => $dataProvider,
			 'sum' => $sum,
			 'return'  => $return,
			 'earnings' => $earnings,
			 'sum_earnings' => $sum_earnings
        ]);
    }
