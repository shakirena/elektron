	 public function actionPrint2($number)
    {
        $searchModel = new SellSearch();
		$searchModel->number=$number;
        $dataProvider = $searchModel->search(Yii::$app->request->queryParams);
		
        $sum=Sell::find()->select('sum(sum) as sum,number,datetime,id_client')->where(['number' => $number])->one();
		$id = $sum->id_client;
		$debt=Dclient::find()->select("sum(debt) as debt")->where("(number!=$number  or number IS NULL) and id_client=$id")->one();
		
		$current=Dclient::find()->andWhere("number=$number")->andWhere(['id_client'=>$sum->id_client])->one();

        return $this->renderAjax('print2',[
            'dataProvider' => $dataProvider,
            'money' => $money,
            'sum' => $sum->sum,
			'current' =>  $current,
            'number' => $sum->number,
			'client'=>$sum->id_client,
			'debt'=>round($debt->debt,2),
			'date'=>$sum->datetime,
        ]);
		
		


    }
	
	
	public function actionPrintPayment($id,$sum)
    {
    $dclient=Dclient::find()->select("sum(debt) as sum")->where(["id_client"=>$id])->one()->sum;
	
	
	$debt_new=$dclient-$sum;
        return $this->renderAjax('print_paym',[
           
            'id' => Yii::$app->request->get('id'),
            'debt' => round($dclient,2),
			'sum'=>Yii::$app->request->get('sum'),
			'debt_new' =>round($debt_new,2)
           
        ]);

    }
	 public function actionDclientAdd()
    {
        $model = new Dclient();
        if (Yii::$app->request->post()) {
            $dclient = Yii::$app->request->post("Dclient");

      
            $model->id_client = $dclient['id_client'];
			
			$model->debt = $dclient['debt'];
		
			$model->datetime = date("Y-m-d H:i:s");

           if($dclient['debt']>0) $model->save();
			return $this->redirect(['dialog']);
        }
        else {
            
            return $this->renderAjax('dclient_add', [
                'model' => $model,
            ]);
        }

    }
