    public function actionUpdatePrice($id, $price)
    {
         $model =Sell2::find()->where(['id'=>$id])->one();
        $model->price = $price;
        $model->sum = $price * $model->quantity;
        $model->save();

        return $model->sum;

    }
    public function actionUpdateUsd($id, $price)
    {
        $model =Sell2::find()->where(['id'=>$id])->one();
        $model->usd = $price;
        $rate=Exchange::find()->one();
        $azn=$price * $rate->rates;
        $model->sum = $azn * $model->quantity;
        $model->price=$azn;
        $model->save();

    }
	
	  public function actionUpdateUsdAzn($id)
    {
        $model =Sell2::find()->where(['id'=>$id])->one();
        $rate=Exchange::find()->one();
        $price=$model->price * $rate->rates;
        $model->usd = $price;
        $model->save();

    }
    public function actionUpdateSn($id, $sn)
    {
        $model =Sell2::find()->where(['id'=>$id])->one();
        $model->sn = $sn;

        $model->save();

    }
