						}
						 $row->delete();
					   
			}
			
	
	$barcode=new Dclient();
	$barcode->deleteAll(['number' => $number]);
	$barcode=new Costs();
	$barcode->deleteAll(['fid' => $number,'id_type' => 3]);
	$barcode=new Costs();
	$barcode->deleteAll(['fid' => $number,'id_type' => 4]);

}
