	public function actionTest()
	{
		$sum = 0;
		foreach (Sell::find()->select("sum(quantity) as quantity,id_product")->groupBy("id_product")->all() as $sell)
		{
				$sum =$sum + $sell->quantity;
            $arrival = Arrival::find()->select("sum(rest) as rest,sum(quantity) as quantity,id_product")->where(["id_product"=>$sell->id_product])->one();
			$return = ReturnArrival::find()->select("sum(quantity) as quantity,id_product")->where(["id_product"=>$sell->id_product])->one();
			$rest =$rest + $arrival->rest ;
				$quantity =$quantity + $arrival->quantity ;
			//if ($arrival->quantity + $return->quantity - $sell->quantity !=   $arrival->rest) 
				echo $sell->id_product."$arrival->quantity - $sell->quantity =($rest) $arrival->rest<br>";
		}
		
		echo $sum."-".$rest.'-'.$quantity;
		
	}
