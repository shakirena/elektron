    public function actionCheckRest($store){
        $model = new Sell2();
		$flag=-1;
        foreach ($model->find()->where(['sold' => 0,'postponed'=>0,'id_user'=>Yii::$app->user->identity->id_user])->all() as $row) {
            $arrival = Arrival::find()
                ->select('sum(rest) as rest')
                ->where(['id_product' => $row->id_product,'id_store'=>$store])
                ->groupBy('id_product')
                ->one();
            if (round($arrival->rest,4)>=round($row->quantity,4))
            { $flag=1;}
            else
			{ $flag=Product::find()->where(["id"=>$row->id_product])->one()->name;break;}
               
        }

        if ($flag==1) return 0;
        else return $flag;
    }
