    public function actionReceivedReturn($id,$quantity,$reason,$client)
    {
        $returnp=new Returnp();
        $returnp->id_product=$id;
        if (!$reason) $reason="";
        $returnp->reason=$reason;
        $returnp->id_client=$client;
        $returnp->quantity=$quantity;
        $returnp->data=date("Y-m-d");
        $returnp->id_user= Yii::$app->user->identity->id_user;
        $returnp->save();
        $returnp->save();
        $arrival=Arrival::find()->where(["id_product"=>$id])->orderBy("datetime DESC")->one();

        $arrival->rest=$arrival->rest+$quantity;
        $arrival->save();


      //  $dclient=Dclient::find()->where(['number'=>Sell::find()->where(["id"=>$returnp=>])])
      Yii::$app->session->remove('id_bonus');
      Yii::$app->session->remove('bonus');

    }

       public function actionInsert($id, $quantity)
    {
        $arrival=Arrival::find()
            ->select('pricesell,trade_price')
            ->where(['id_product' => $id,'received'=>1])
            ->orderBy([
                'datetime' => SORT_DESC
            ])
            ->one();
		
		$pricesell=Sell::find()->where(["id_product"=>$id,'id_client'=>Yii::$app->session->get('id_client')])->andWhere("id_client!=1")->orderBy("id DESC")->one();	
			
        $sell=Sell2::find()->where(['sold' => 0,'id_user'=>Yii::$app->user->identity->id_user,'postponed'=>0])->one();
        if ($sell->number) $max=$sell->number;
	  else {
				$sell=Sell2::find()->where(['sold' => 0,'id_user'=>Yii::$app->user->identity->id_user])->orderBy("id DESC")->one();
			if ($sell->number)
				if ($sell->postponed>0) 	{   $max1 = Sell::find()->select('number')->max('number');
												$max2 = Sell2::find()->select('number')->max('number');
												if ($max1)
												if ($max1>$max2) $max = $max1 + 1;
												else $max = $max2 + 1;
													else $max = 1;
											}
				else $max=$sell->number;
			else 	{   $max1 = Sell::find()->select('number')->max('number');
												$max2 = Sell2::find()->select('number')->max('number');
												if ($max1)
												if ($max1>$max2) $max = $max1 + 1;
												else $max = $max2 + 1;
													else $max = 1;
											}


        }
        $sell=Sell2::find()->where(["id_product"=>$id, 'id_user'=>Yii::$app->user->identity->id_user, 'sold'=>0,'postponed'=>0])->one();
        if ($sell->id) {
            $sell->quantity=$sell->quantity+$quantity;
			$sell->sum=$sell->quantity*$sell->price;
			 $sell->datetime = date("Y-m-d H:i:s");
            $sell->save();
        }
        else {
			
			
			
			$sell = new Sell2();
            $sell->id_product = $id;
            $sell->id_user = Yii::$app->user->identity->id_user;
			if (Yii::$app->session->get('id_client')!=1) {
			if ($pricesell->price) $price=$pricesell->price;
			else $price=$arrival->pricesell;}
			else
			if ($arrival->pricesell) $price=$arrival->pricesell;
            else $price=0;
			if ($arrival->trade_price) $trade_price=$arrival->trade_price;
            else $trade_price=0;
            if(preg_match("/(.*?)\/(.*?)/", $quantity))
            {


                $string_t = preg_replace('/\/.*/', '', $quantity);
                $string_b = preg_replace('/.*?\//', '', $quantity);
                $count=$string_t/$string_b;
                $quantity=round($count, 4);
                $sell->price= Arrival::find()->where(['id_product' =>  $id])->orderBy("id DESC")->one()->price_top;
                $sell->sum = $string_t * $sell->price;
            }
            else {
            $sell->price =$price;
            $sell->sum = $quantity*$price;}
            $sell->quantity = $quantity;
            $sell->datetime=date("Y-m-d H:i:s");
            $sell->sold = 0;
            $sell->number=$max;
			$sell->usd =$trade_price;
            $sell->id_store=Yii::$app->session->get("store");
            $sell->save();
        }
		
        


        var_dump( $sell);


    }
	public function actionCheckKassa($sum)
	{
	 if (!Yii::$app->session->get('id_bonus')) return 1;
	 $bonus = $this->actionBonusSum(Yii::$app->session->get('id_bonus'));
	if ($bonus<$sum) return 2;
	 
	
	}
	public function actionCheckBonus($barcode)
	{
		
		  if (substr($barcode,0,2)==26 && strlen($barcode) == 13) {
				$client = Client::find()->where(['barcode' => $barcode ])->one();
				if ($client) {
				Yii::$app->session->set('id_bonus', $client->id_client);
				Yii::$app->session->set('bonus',  $client->fio);
				return 1;
				}
			}
		return 0;
		
	}

