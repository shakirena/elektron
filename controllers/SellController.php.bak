	public function actionClear()
	{
		
		foreach (Barcodep::find()->all() as $barcode)
		{
			$product=Product::find()->where(["id"=>$barcode->id_product])->one();
			if ($product->id) continue;
			else $barcode->delete();
			
			
		}
		
		
	}
	public function actionBonusSum($id=NULL)
    {
        if (!$id) $id =  Yii::$app->session->get('id_bonus');
		if ($id){
        $prixod = Costs::find()->select("sum(sum) as sum")->where(['id_client' => $id,'id_kassa' =>1,'id_type' =>4])->one()->sum;
        $rasxod = Costs::find()->select("sum(sum) as sum")->where(['id_client' => $id,'id_kassa' =>1,'id_type' =>3])->one()->sum;
        $itog = round($prixod - $rasxod,2);}
        return $itog;
    }
