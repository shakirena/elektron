  public function actionImportXls()
    {

        $thumb=file_get_contents("D:\\terezi.xls");
      //  print_r($thumb);
       // $thumb=iconv("ASCII",'UTF-8',)
        $thumb=mb_convert_encoding($thumb,'UTF-8','UCS-2LE');
    //  echo  mb_detect_encoding($thumb);
        $thumb=str_replace(',','.',$thumb);
        $thumb1=explode("\n", $thumb);;
        $count=0;$i=0;
        foreach($thumb1 as $key=>$val)
        {

            if ($i>0) {



                $ln = explode("\t", $val);
                if ($ln[2]>0) $product = Product::find()->andWhere(['plu' => $ln[2]])->one();
                $name=mb_convert_encoding($ln[1],'UTF-8',mb_detect_encoding($ln[1]));
               // echo $name;
                if ($product->id) {
                    $data = array($ln[0], $ln[4], $ln[2]);
                    $product = Product::find()->where(['plu' => $ln[3]])->one()->id;
					$model=Product::find()->where(['plu' => $ln[3]])->one();
					$model->name=$name;
					$model->save();
                   
					
					$barcode=new Barcodep();
					$barcode->deleteAll(['id_product' => $product]);
					
					 $barcode=new Barcodep();
                    $barcode->id_product=$model->id;
                    $barcode->name="tərəzi";
                    $barcode->save();

                    //$sth = $dbh->prepare("UPDATE product SET NAME=?,price=? WHERE plu=?");
                    //$sth->execute($data);
                } else {


                    $product = new Product();
                    $product->name =$name;
                  // echo  $product->name;
                    $product->plu = $ln[3];
                    $product->id_type = 1;
                   $count++;
                //    print_r($product);
                    $product->save();
                    $barcode=new Barcodep();
                    $barcode->id_product=$product->id;
                    $barcode->name="tərəzi";
                    $barcode->save();

                   

                }
            }
           $i++;
        }
        echo $count." çeşiddə mal əlavə olundu";
    }
       
 public function actionUpdateQuantity($id, $quantity)
    {
        $model =Sell2::find()->where(['id'=>$id])->one();
		    if(preg_match("/(.*?)\/(.*?)/", $quantity))
        {


            $string_t = preg_replace('/\/.*/', '', $quantity);
            $string_b = preg_replace('/.*?\//', '', $quantity);
            $count=$string_t/$string_b;
            $quantity=round($count, 4);
            $model->price= Arrival::find()->where(['id_product' =>  $model->id_product])->orderBy("id DESC")->one()->price_top;
            $model->sum = $string_t * $model->price;
        }
        else $model->sum = $quantity * $model->price;
		
        $model->quantity = $quantity;

       
        $model->save();

        return $model->sum;

    }
