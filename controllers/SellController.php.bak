    public function actionMpdf()
    {

        $searchModel = new Sell2Search(['sold' => 0,'id_user'=> Yii::$app->user->identity->id_user]);
        $dataProvider = $searchModel->search(Yii::$app->request->queryParams, 'received');
        $client=Client::find()->where(['id_client' =>   Yii::$app->session->get('id_client')])->one();
        $sum=Sell::find()->select('sum(sum) as sum,number,datetime,date_issue')->where(['sold' => 0,'id_user'=> Yii::$app->user->identity->id_user])->one();
        $user=Users::find()->where(["id_user"=>Yii::$app->request->get('user')])->one()->fio;

        $pdf = new Pdf([
            'mode' => Pdf::MODE_UTF8, // leaner size using standard fonts
            'orientation' => Pdf::ORIENT_LANDSCAPE,
            'marginTop' => "0px",
            'marginLeft' => "3px",
            'marginRight' => "3px",
            'content' => $this->renderPartial('print', [
                // 'searchModel' => $searchModel,
                'dataProvider' => $dataProvider,
                'client' => $client,
                'money' => Yii::$app->request->get('money'),
                'sum' => $sum->sum,
                'number' => $sum->number,
                'date' => Yii::$app->request->get('date'),
                'date_issue' => Yii::$app->request->get('issue'),
                'user' =>$user,
            ]),
            'options' => [
                'title' => 'MARKET',
                //'subject' => 'Generating PDF files via yii2-mpdf extension has never been easy',

            ],
            'methods' => [
                // 'SetHeader' => ['Generated On: ' . date("r")],
                'SetFooter' => false,
                'SetJS' =>'this.print();'
            ]
        ]);


        return $pdf->render();
    }
    public function actionPrint($money,$discount,$user,$kassa,$virtual)
    {
		$discount = 0;
        $searchModel = new Sell2Search(['sold' => 0,'id_user'=> Yii::$app->user->identity->id_user,'postponed'=>0]);
        $dataProvider = $searchModel->search(Yii::$app->request->queryParams, 'received');
        $sum=Sell2::find()->select('sum(sum) as sum,number,datetime,user_issue')->where(['sold' => 0,'id_user'=> Yii::$app->user->identity->id_user, 'postponed'=>0])->one();
		$sum->sum = round($sum->sum,2);
		$debt=Dclient::find()->select("sum(debt) as sum")->where(["id_client"=>Yii::$app->session->get('id_client')])->one();
		if ($debt) $debt=$debt->sum;
		
		foreach ( Sell2::find()->where(['sold' => 0,'id_user'=> Yii::$app->user->identity->id_user, 'postponed'=>0])->all() as $model)
		{
			$discount = $discount + $model->quantity*( $model->getPriceSell() - $model->price) ;
			
		}
		
        return $this->renderAjax('print',[
            'dataProvider' => $dataProvider,
            'money' => $money,
            'sum' => $sum->sum,
			'user' => $user,
            'number' => $sum->number,
			'kassa' => $kassa,
			'virtual' => $virtual,
			'client'=>Yii::$app->session->get('id_client'),
			'debt'=>round($debt,2),
			'discount' => $discount,
        ]);

    }
	
