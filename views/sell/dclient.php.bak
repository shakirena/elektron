                'label' =>'Ödəniş',
                'format' => 'raw',
				 'width' => '130px',
                'value' => function ($model, $index, $widget) {
                    return Html::input('text', 'sum[]', 0, ['class' => '', 'size' => '3','id' => 'sum'.$model["id_client"]]).	Select2::widget([
							'data' =>  ArrayHelper::map(Kassa::find()->where("id>1")->orderBy("id DESC")->all(), 'id', 'name'),
